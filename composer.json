{
    "name": "app/gmail-api-factory",
    "description": "Multi-account Gmail API wrapper for Laravel: fetch, send and manage messages through the Gmail REST API.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "google/apiclient": "^2.15",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "symfony/mime": "^6.4|^7.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Shared\\Gmail\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "test": "phpunit",
        "bump": "php bin/bump-version"
    },
    "extra": {
        "google/apiclient-services": [
            "Gmail"
        ],
        "laravel": {
            "providers": [
                "App\\Shared\\Gmail\\GmailServiceProvider"
            ],
            "aliases": {
                "Gmail": "App\\Shared\\Gmail\\Facade\\Gmail"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
