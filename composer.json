{
    "name": "app/gmail-api-factory",
    "description": "Multi-account Gmail API wrapper for Laravel: fetch, send and manage messages through the Gmail REST API.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "google/apiclient": "^2.20",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "symfony/mime": "^7.4|^8.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Shared\\Gmail\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "test": "phpunit",
        "bump": "php bin/bump-version"
    },
    "extra": {
        "google/apiclient-services": [
            "Gmail"
        ],
        "laravel": {
            "providers": [
                "App\\Shared\\Gmail\\GmailServiceProvider"
            ],
            "aliases": {
                "Gmail": "App\\Shared\\Gmail\\Facade\\Gmail"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
